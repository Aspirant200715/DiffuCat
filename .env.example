# ==========================================
# DiffuCat Environment Variables (Real Data)
# ==========================================

# 1. Cloud DFT Engine API (AWS API Gateway / Lambda)
# Used in: src/validation/engines/cloud_api.py
# Disables the deterministic mock simulation and sends graphs to real quantum solvers.
AWS_DFT_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
AWS_DFT_API_KEY=your_aws_api_gateway_key_here

# 2. Local ORCA Engine (Alternative to Cloud DFT)
# Used in: src/validation/engines/orca.py
# Set this to the absolute path of your ORCA executable if running DFT locally.
ORCA_PATH=/path/to/orca

# 3. Redis / Celery (Background Tasks)
# Used in: src/backend/core/celery_app.py
# Replace with a cloud Redis URL (e.g., Upstash or Redis Enterprise) for production.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 4. Authentication Secret
# Used in: src/backend/core/config.py
# Must be a securely generated random string in production.
JWT_SECRET=generate_a_secure_random_string_here

# 5. Frontend API URL
# Used in: frontend/.env.local
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000