# ==================== ML & CHECKPOINTS ====================
# Model weights & checkpoints (large, reproducible via training)
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.pb
*.tflite
*.mlmodel
checkpoints/
!checkpoints/.gitkeep

# TensorBoard logs
runs/

# MLflow
mlruns/
*.mlflow/

# ==================== DVC (Data Version Control) ====================
# .dvc/ directory and *.dvc files contain METADATA and MUST be tracked by Git
# Only ignore the actual data cache and temporary files
.dvc/cache/
.dvc/tmp/
*.dvc.tmp


# ==================== DATA (LARGE/SENSITIVE) ====================
# Raw data (should be downloaded via scripts, not committed)
data/raw/*
!data/raw/.gitkeep

# Processed data (can be regenerated)
data/processed/*
!data/processed/.gitkeep

# Large datasets (use DVC or download scripts)
*.h5
*.hdf5
*.parquet
*.feather
*.arrow
*.npz
*.npy
*.csv
!data/small_test.csv

# ==================== LOGS & TEMP ====================
# Application logs
logs/
*.log
log/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ==================== SECRETS & CONFIGS ====================
# Environment variables & secrets (NEVER commit these)
.env
.env.local
.env.*.local
*.secret
*.key
*.pem
*.crt
*.p12

# API keys, passwords, tokens (use env vars or secret managers)
config/secrets.yaml
configs/credentials.yaml
configs/auth.json

# AWS/Azure/GCP credentials
.aws/
.azure/
.gcp/
boto.cfg
google-cloud-key.json

# ==================== DOCKER & K8S ====================
# Docker (keep Dockerfile, ignore override/compose local)
docker-compose.override.yml
*.dockerignore
docker-compose.local.yml

# Kubernetes (ignore local configs, keep templates)
*.kubeconfig
kubeconfig
k8s/local-*
k8s/*-local.yaml

# ==================== DOCUMENTATION ====================
# Sphinx / MkDocs build outputs
docs/_build/
site/
build/html/

# Local documentation exports
*.pdf
*.docx
*.pptx
*.key

# ==================== TESTING ====================
# Coverage reports
coverage.xml
coverage.json
.coverage.*

# Hypothesis
.hypothesis/

