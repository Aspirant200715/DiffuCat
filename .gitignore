# ==================== DATA (LARGE/SENSITIVE) ====================
# Raw data (should be downloaded, not committed)
data/raw/*
!data/raw/.gitkeep
# Processed data (can be regenerated)
data/processed/*
!data/processed/.gitkeep
# Large datasets
*.h5
*.hdf5
*.parquet
*.feather
*.arrow

# ==================== LOGS & TEMP ====================
logs/
*.log
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# ==================== SECRETS & CONFIGS ====================
# Environment variables & secrets
.env
.env.local
.env.*.local
*.secret
*.key
*.pem
# API keys, passwords, tokens
config/secrets.yaml
configs/credentials.yaml
# AWS/Azure/GCP credentials
.aws/
.azure/
.gcp/
boto.cfg

# ==================== DOCKER & K8S ====================
# Docker
docker-compose.override.yml
*.dockerignore
