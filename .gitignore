*.pdf
*.docx
*.pptx

# ==================== NOTEBOOKS (OPTIONAL) ====================
# Keep notebooks out of main branch; use /notebooks/ for experiments
notebooks/*.ipynb
!notebooks/.gitkeep
# Jupyter server info
*.ipynb_checkpoints/

# ==================== TESTING ====================
# Coverage reports
coverage.xml
coverage.json
# Hypothesis
.hypothesis/

# ==================== PROJECT-SPECIFIC ====================
# DiffuCat artifacts
*.pdb  # RDKit temporary files
conformer_*.sdf  # RDKit conformer exports
*.xyz  # Quantum chemistry outputs (unless small)
*.log  # ORCA/Gaussian/VASP logs (large)
*.out  # Job scheduler outputs
*.err  # Error logs from HPC jobs
# Temporary visualization exports
viz_*.png
viz_*.html