*.bak
*.old
*.orig

# Archive files (unless intentional)
*.zip
*.tar.gz
*.rar
!releases/

# ==================== GIT ====================
# Merge conflict markers (should never be committed)

# ==================== RECOMMENDED: Keep These Tracked ====================
# ! = explicitly track despite patterns above
!README.md
!CONTRIBUTING.md
!LICENSE
!requirements/
!configs/default.yaml
!configs/backend.yaml.example
!src/
!tests/
!scripts/
!docker/Dockerfile
!docker/docker-compose.yml
!k8s/deployment.yaml.example
!notebooks/.gitkeep
!data/.gitkeep
!checkpoints/.gitkeep